# Preserves Google's existing rankings for the pages that changed URL when
# this site replaces the old WordPress one. Without these, the old indexed
# URLs 404 and the site loses whatever it was already ranking for.
#
# This file must end up in public_html alongside the exported site.

RewriteEngine On

# Old WordPress URL -> new page
Redirect 301 /brisbane-chimney-cleaning/ /services/chimney-cleaning/
Redirect 301 /brisbane-fireplace-installation/ /services/fireplace-installation/
Redirect 301 /brisbane-chimney-questions-answers/ /faq/
Redirect 301 /gallery/ /

# /about/ and /contact/ keep the same URL on the new site, so they need no
# redirect. Everything else 404s normally, which is correct.

# --- Static hosting niceties (safe to remove if the host already sets these) ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
